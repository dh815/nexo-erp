# Copie este arquivo para ".env" e preencha com suas chaves reais.
# O ".env" nunca deve ser commitado no GitHub (já está no .gitignore).

# Firebase Console > Configurações do projeto > Seus apps > adicionar app Web
# Use o MESMO projeto Firebase do Fintrack, mas crie um novo "app Web" dentro
# dele (ou um novo Firestore database separado) para o Nexo ERP.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — pode reaproveitar o mesmo cloud name do Fintrack (dj4v0sa2n),
# mas crie um upload preset novo (ex. "nexo_erp") para manter os uploads
# do ERP organizados separadamente.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
